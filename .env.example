# Copy to .env only for the hosted tier (make lesson N=NN TIER=hosted).
# LANTERN runs fully offline on Ollama without any of these. Only synthetic material is sent.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional overrides
# LANTERN_TIER=local            # or hosted
# LANTERN_HOSTED_PROVIDER=anthropic   # or openai, gemini
# LANTERN_MODEL=qwen3:4b
# OLLAMA_HOST=http://localhost:11434

# Logging and tracing (chapter 17). Defaults write to .progress/, which git ignores.
# LANTERN_CALL_LOG=.progress/calls.jsonl   # empty to turn the call log off
# LANTERN_TRACE=1                          # 0 to turn OpenTelemetry spans off
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318   # also send spans to a collector
# Recorded hosted runs: set by `make lesson ... RECORD=1` and `REPLAY=1`.
# LANTERN_RECORD=1
# LANTERN_REPLAY=1
